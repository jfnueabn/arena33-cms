<section class="games-about"><div class="container games-reading"><% if (s.eyebrow) { %><span class="eyebrow"><%= s.eyebrow %></span><% } %><h2><%= s.title %></h2><% if (s.subtitle) { %><p><%= s.subtitle %></p><% } %><% c.items.forEach(faq => { %><details class="games-faq"><summary><%= faq.question %></summary><p><%= faq.answer %></p></details><% }) %><p class="games-notice"><%= c.notice %></p></div></section>
