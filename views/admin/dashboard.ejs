<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Dashboard · LV55 Admin</title>
  <link rel="stylesheet" href="<%= assetUrl('admin/admin.css') %>">
</head>
<body>
  <header class="topbar">
    <button class="icon-btn only-mobile" id="sideToggle" aria-label="Toggle menu">☰</button>
    <div class="brand" id="adminBrand"><%= brand.text %><span><%= brand.accent %></span> <small>Admin</small></div>
    <div class="top-actions">
      <button class="btn ghost" id="togglePreview">Hide preview</button>
      <a class="btn ghost" id="viewSite" href="/" target="_blank" rel="noopener">View page ↗</a>
      <button class="btn ghost" id="pwBtn">Change password</button>
      <form method="post" action="/admin/logout"><button class="btn ghost" type="submit">Log out (<%= admin.username %>)</button></form>
    </div>
  </header>

  <div class="layout" id="layout">
    <aside class="sidebar" id="sidebar">
      <label class="page-select-label" for="pageSelect">Editing page</label>
      <select id="pageSelect" class="page-select" aria-label="Editing page"></select>
      <button class="side-item" data-open="page-settings">⚙️ Page settings &amp; SEO</button>
      <p class="side-label">Shared across all pages</p>
      <button class="side-item" data-open="settings">🎨 Site settings &amp; branding</button>
      <div id="fixedList"></div>
      <p class="side-label"><span id="sectionLabel">Page sections</span> <span class="hint">drag or use arrows to reorder</span></p>
      <div id="builderActions" class="builder-actions" hidden><button id="addSectionBtn" class="btn primary" type="button">+ Add section</button><button id="sectionTemplatesBtn" class="btn ghost" type="button">Use template</button><button id="removedSectionsBtn" class="btn ghost" type="button">Removed sections</button></div>
      <ol id="sectionList" class="section-list"></ol>
    </aside>

    <main class="editor" id="editor">
      <div class="empty">Loading…</div>
    </main>

    <section class="preview" id="previewPane" aria-label="Live preview">
      <div class="preview-bar">Live preview <span class="muted small">updates after you save</span></div>
      <iframe id="preview" src="/" title="Selected page preview"></iframe>
    </section>
  </div>

  <dialog id="pwDialog">
    <form id="pwForm">
      <h2>Change password</h2>
      <label>Current password <input type="password" name="current" autocomplete="current-password" required></label>
      <label>New password (min 6) <input type="password" name="next" minlength="6" autocomplete="new-password" required></label>
      <p class="form-error" id="pwError"></p>
      <div class="row-end">
        <button type="button" class="btn ghost" id="pwCancel">Cancel</button>
        <button type="submit" class="btn primary">Update</button>
      </div>
    </form>
  </dialog>

  <dialog id="sectionBuilderDialog" class="section-builder-dialog" aria-labelledby="sectionBuilderTitle"><div class="builder-dialog-head"><h2 id="sectionBuilderTitle">Add a section</h2><button type="button" id="closeSectionBuilder" class="btn ghost">Close</button></div><div id="sectionBuilderContent"></div></dialog>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script src="<%= assetUrl('admin/nav-links.js') %>"></script>
  <script src="<%= assetUrl('admin/admin.js') %>"></script>
</body>
</html>
