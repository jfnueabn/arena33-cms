PORT=3000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=arena33

# Long random string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# First admin account, created by `npm run db:setup` when no admin exists
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-min-6-chars

# Hosted MySQL (Aiven etc.): turn on SSL and paste the provider's CA certificate
DB_SSL=false
DB_CA_CERT=
# ...or point to the downloaded certificate file instead (kept out of git)
DB_CA_CERT_PATH=

# Public site address used for canonical/sitemap on first setup (optional)
SITE_URL=

# Optional overrides for the installed offline translation runtime
TRANSLATION_PYTHON=
TRANSLATION_MODEL_DIR=
