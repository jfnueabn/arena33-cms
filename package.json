{
  "name": "arena33-cms",
  "version": "1.0.0",
  "private": true,
  "description": "SEO landing page with an admin CMS (Express + MySQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "node db/setup.js",
    "db:reset": "node db/setup.js --reset"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.7",
    "ejs": "3.1.10",
    "express": "4.21.2",
    "express-mysql-session": "3.0.3",
    "express-session": "1.18.1",
    "multer": "2.0.2",
    "mysql2": "3.11.5"
  }
}
