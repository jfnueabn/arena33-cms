<% if(typeof breadcrumbs==='undefined'||!breadcrumbs.renderAtTop) { %>
<div class="bonus-breadcrumb"><div class="container"><a href="<%= pagePath('home', locale) %>"><%= t("Home") %></a><span aria-hidden="true">/</span><span><%= t("Welcome Bonus") %></span></div></div>
<% } %>
<section class="hero bonus-hero">
  <div class="container bonus-hero-grid">
    <div><% if (s.eyebrow) { %><span class="eyebrow"><%= s.eyebrow %></span><% } %>
      <h1><%= s.title %></h1><p class="bonus-intro"><%= c.description %></p>
      <% if (s.subtitle) { %><p class="bonus-intro"><%= s.subtitle %></p><% } %>
      <div class="games-actions">
        <% if (c.primary_button.text) { %><a class="btn btn-primary" href="<%= safeUrl(c.primary_button.url) %>"><%= c.primary_button.text %></a><% } %>
        <% if (c.secondary_button.text) { %><a class="btn btn-ghost" href="<%= safeUrl(c.secondary_button.url) %>"><%= c.secondary_button.text %></a><% } %>
      </div>
    </div>
    <div class="bonus-welcome-card">
      <span class="bonus-gift" aria-hidden="true">🎁</span>
      <% if (c.sample_label) { %><span class="bonus-sample"><%= c.sample_label %></span><% } %>
      <p class="bonus-card-label"><%= c.card_label %></p><p class="bonus-value"><%= c.card_value %></p><p><%= c.card_description %></p>
      <dl class="bonus-highlights"><% c.highlights.forEach(item => { %><div><dt><%= item.label %></dt><dd><%= item.value %></dd></div><% }) %></dl>
      <div class="bonus-deadline"><p><%= c.countdown_label || 'Offer period' %></p>
      <% if (c.target_date && Number.isFinite(Date.parse(c.target_date))) { %><div class="timer bonus-timer" data-target="<%= c.target_date %>" aria-label="Offer countdown"><% [['d','Days'],['h','Hours'],['m','Minutes'],['s','Seconds']].forEach(([unit,label]) => { %><div><b data-unit="<%= unit %>">00</b><small><%= t(label) %></small></div><% }) %></div>
      <% } else { %><div class="bonus-timer-static" aria-label="No offer end date set"><span>—<small><%= t("Days") %></small></span><span>—<small><%= t("Hours") %></small></span><span>—<small><%= t("Minutes") %></small></span><span>—<small><%= t("Seconds") %></small></span></div><p class="bonus-deadline-note"><%= c.countdown_empty || 'Contact us for the current offer period.' %></p><% } %>
      </div>
    </div>
  </div>
</section>
<% if (c.image) { %><div class="container bonus-promo-image"><img src="<%= safeUrl(c.image) %>" alt="<%= c.image_alt %>" width="1200" height="520" fetchpriority="high"></div><% } %>
