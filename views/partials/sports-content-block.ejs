<% if(block.type==='match_preview') { %>
  <div class="sports-scoreboard"><div class="sports-scoreboard-head"><span class="sports-signal" aria-hidden="true"></span><%= value.preview_label %><span aria-hidden="true">⚽</span></div><% value.matches.forEach(match=>{ %><article class="sports-match"><div class="sports-match-meta"><span><%= match.league %></span><span><%= match.status %></span></div><div class="sports-teams"><strong><%= match.home %></strong><b><%= match.score %></b><strong><%= match.away %></strong></div><dl class="sports-prices"><% match.markets.forEach(market=>{ %><div><dt><%= market.label %></dt><dd><%= market.value %></dd></div><% }) %></dl></article><% }) %><p class="sports-preview-note"><%= value.preview_note %></p></div>
<% } else if(block.type==='highlights') { %>
  <div class="sports-summary"><dl><% value.items.forEach(item=>{ %><div><dt><%= item.label %></dt><dd><%= item.value %></dd></div><% }) %></dl></div>
<% } else if(block.type==='sport_categories') { %>
  <div class="sports-category-grid"><% value.items.filter(item=>item.visible).forEach(item=>{ %><article class="card sports-category"><% if(item.image) { %><img src="<%= safeUrl(item.image) %>" alt="<%= item.image_alt %>" loading="lazy" width="480" height="280"><% } else { %><div class="sports-category-art" aria-hidden="true"><%= item.icon %></div><% } %><div class="sports-category-copy"><span class="sports-category-badge"><%= item.badge %></span><h3><%= item.title %></h3><p><%= item.description %></p><ul><% item.tags.forEach(tag=>{ %><li><%= tag %></li><% }) %></ul></div></article><% }) %></div>
<% } %>
