{
  "name": "lv55-cms",
  "version": "1.0.0",
  "private": true,
  "description": "SEO landing page with an admin CMS (Express + MySQL)",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "db:setup": "node backend/db/setup.js",
    "db:reset": "node backend/db/setup.js --reset",
    "admin:password": "node backend/db/setup.js --reset-admin-password",
    "translations:setup": "node backend/translation/setup.js",
    "translations:sync": "node backend/translation/sync.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.7",
    "ejs": "3.1.10",
    "express": "4.21.2",
    "express-mysql-session": "3.0.3",
    "express-session": "1.18.1",
    "multer": "2.0.2",
    "mysql2": "3.11.5"
  }
}
